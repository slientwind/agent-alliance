{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Alliance 服务运行 API",
    "version": "1.0.0",
    "description": "服务绑定应用凭证。带成员委托时，后续读取和操作须使用受理时的同一委托。"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "Application": []
    },
    {
      "Application": [],
      "MemberDelegation": []
    }
  ],
  "paths": {
    "/services/{id}": {
      "get": {
        "operationId": "describeService",
        "summary": "读取当前应用获授权的服务及默认版本",
        "description": "管理端发布或回退后，此处展示当前默认版本。调用方核对该版本的资料、步骤和审核约定后选择发起版本。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Service"
                }
              }
            }
          },
          "default": {
            "description": "401 凭证失效，403 委托无效，404 对象不可见，409 状态或幂等冲突，422 输入无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/services/{id}/runs": {
      "post": {
        "operationId": "startRun",
        "summary": "确认版本和调用次数后受理任务",
        "description": "在请求中明确指定已发布版本。默认版本调整之后，继续采用调用方明确选定且当前授权、审核人及固定依赖仍可用的版本。服务声明 allowDocumentAttachments 时，发起时可附含可读取文字的 DOCX、XLSX、PPTX 或 PDF。资料在受理前读取，失败时用原资料重试。已受理的幂等重放直接返回原回执。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        ],
        "responses": {
          "202": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            }
          },
          "default": {
            "description": "401 凭证失效，403 委托无效，404 对象不可见，409 状态或幂等冲突，413 请求体超限，422 输入或文档无法读取，503 文档读取暂不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          }
        }
      }
    },
    "/runs/{id}": {
      "get": {
        "operationId": "getProgress",
        "summary": "查询步骤、阻塞、审核与下一步操作",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Progress"
                }
              }
            }
          },
          "default": {
            "description": "401 凭证失效，403 委托无效，404 对象不可见，409 状态或幂等冲突，422 输入无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/rule-rebuild": {
      "get": {
        "operationId": "previewRuleBranchRebuild",
        "summary": "预览原任务中受规则失效影响的步骤和可沿用成果",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "重做范围、确切成果版本和本批调用上限",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RuleBranchPreview" } } }
          },
          "default": {
            "description": "原任务不可见、授权失效或需先核对调用回执",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
          }
        }
      }
    },
    "/runs/{id}/actions": {
      "post": {
        "operationId": "actOnRun",
        "summary": "控制运行、补充待提交步骤或提出成果修改建议",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionReceipt"
                }
              }
            }
          },
          "default": {
            "description": "401 凭证失效，403 委托无效，404 对象不可见，409 状态或幂等冲突，422 输入无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Action"
              }
            }
          }
        }
      }
    },
    "/runs/{id}/calls/{step}/column-suggestion": {
      "post": {
        "operationId": "suggestRunColumns",
        "summary": "由原委托成员授权一次字段建议",
        "description": "模型输入限于本次字段名、用途及候选表头。结果使用 columnCorrections 中的资料、字段、候选列顺序，序号从 1 开始。同一次拒绝回执的重复请求返回原结果。",
        "security": [
          {
            "Application": [],
            "MemberDelegation": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "step",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "attempt": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "expected": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "authorizeOneCall": {
                    "const": true
                  }
                },
                "required": [
                  "attempt",
                  "expected",
                  "authorizeOneCall"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "字段建议回执",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ColumnSuggestion"
                }
              }
            }
          },
          "default": {
            "description": "401 凭证失效，403 委托无效，404 对象不可见，409 原回执、模型或预算变化，422 输入无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/events": {
      "get": {
        "operationId": "followEvents",
        "summary": "按游标查询，或以 SSE 接收关键事件",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    }
                  },
                  "required": [
                    "events"
                  ]
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "event: update，id 为运行内单调递增游标，data 为 Event。连接最长 25 秒，可携带游标重连。"
                }
              }
            }
          },
          "default": {
            "description": "401 凭证失效，403 委托无效，404 对象不可见，409 状态或幂等冲突，422 输入无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/delivery": {
      "get": {
        "operationId": "getDelivery",
        "summary": "获取已确认的版本清单",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "edition",
            "in": "query",
            "description": "已确认的交付批次。省略时固定读取第一批，进度接口提供各批次地址。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Delivery"
                }
              }
            },
            "headers": {
              "X-Delivery-Distribution": {
                "description": "本次发送时的分发状态。reference 表示原资料已撤权，项目已核对该批成果可独立分发。",
                "schema": {
                  "type": "string",
                  "enum": [
                    "clear",
                    "reference"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "401 凭证失效，403 委托无效，404 对象不可见，409 状态或幂等冲突，422 输入无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{id}/delivery/package": {
      "get": {
        "operationId": "downloadPackage",
        "summary": "下载已确认的 ZIP 成果包",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "edition",
            "in": "query",
            "description": "已确认的交付批次。省略时固定读取第一批，进度接口提供各批次地址。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "X-Delivery-Distribution": {
                "description": "本次发送时的分发状态。reference 表示原资料已撤权，项目已核对该批成果可独立分发。",
                "schema": {
                  "type": "string",
                  "enum": [
                    "clear",
                    "reference"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "401 凭证失效，403 委托无效，404 对象不可见，409 状态或幂等冲突，422 输入无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Application": {
        "type": "http",
        "scheme": "bearer"
      },
      "MemberDelegation": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Alliance-Delegation"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "requestId"
        ]
      },
      "Service": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "example": {
            "type": "string"
          },
          "team": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "authorizeCalls": {
            "type": "integer",
            "minimum": 1
          },
          "ready": {
            "type": "boolean"
          },
          "allowDocumentAttachments": {
            "type": "boolean",
            "description": "当前服务版本可在发起时读取 DOCX、XLSX、PPTX 与含可读取文字的 PDF。"
          },
          "requiresPictures": {
            "type": "boolean",
            "description": "发起时需提交 PNG 或 JPEG 原件。识图支持 1 至 4 张，editsImage 为 true 时必须恰好一张。"
          },
          "editsImage": {
            "type": "boolean",
            "description": "当前服务版本包含参考图编辑，发起时须提交恰好一张 PNG 或 JPEG 原件。"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "lookupPhase": {
                  "type": "string",
                  "enum": [
                    "",
                    "search",
                    "answer",
                    "answer_calc",
                    "review_evidence",
                    "synthesize"
                  ],
                  "description": "search 与 answer 表示同一文本 Agent 先检索再回答。answer_calc 可依据引文核算同币种金额。review_evidence 在前轮获得新依据后核对并可提出一次只读补查。synthesize 只有在前轮留下新增依据时才调用模型。发起此类服务须提供 attachment。"
                },
                "toolChoice": {
                  "type": ["object", "null"],
                  "description": "另一项固定的能力候选。selector 指定负责选择的文本步骤，两项候选只执行一项。文本 Agent 收到已授权的任务、资料及相关前置成果；若选中第三方候选，相关内容会发送给它。汇总要求 CSV 附件，文件制作沿用服务的资料约定。",
                  "properties": {
                    "selector": { "type": "integer", "minimum": 1 },
                    "name": { "type": "string" },
                    "revision": { "type": "integer", "minimum": 1 },
                    "primaryRemote": { "type": "boolean", "description": "主要候选为第三方 Agent" },
                    "alternativeRemote": { "type": "boolean", "description": "备选为第三方 Agent" }
                  }
                },
                "operation": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "id",
          "version",
          "ready",
          "authorizeCalls",
          "allowDocumentAttachments",
          "requiresPictures",
          "editsImage",
          "steps"
        ]
      },
      "Attachment": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "UTF-8 TXT、MD、CSV 或 JSON 文件名"
          },
          "data": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "原始非空字节最多 96 KiB"
          }
        },
        "required": [
          "name",
          "data"
        ]
      },
      "ServiceRunAttachment": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "TXT、MD、CSV、JSON，或服务声明支持的 DOCX、XLSX、PPTX、PDF 文件名。requiresPictures 为 true 时支持 PNG、JPG、JPEG。"
          },
          "data": {
            "type": "string",
            "contentEncoding": "base64",
            "description": "原始非空文件字节。文本文件合计不超过 96 KiB，全部原件合计不超过 8 MiB。含文档时，可读取文字与资料标题合计不超过 96 KiB。图片每张最多 3 MiB、4,194,304 像素，每边最多 8192 像素。一次提交最多 4 张、图片合计不超过 6 MiB。"
          }
        },
        "required": ["name", "data"]
      },
      "RunRequest": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "description": "最多 64000 UTF-8 字节"
          },
          "authorizeCalls": {
            "type": "integer",
            "minimum": 1
          },
          "attachment": {
            "$ref": "#/components/schemas/ServiceRunAttachment"
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceRunAttachment"
            },
            "minItems": 1,
            "maxItems": 20,
            "description": "按提交顺序绑定本次请求。禁止同时提供 attachment。含汇总工具选择或已固定的 CSV 汇总步骤时，所有资料均须为 CSV。含原文问答步骤时，须另附可读取的文字资料。"
          },
          "awaitLookupReceipt": {
            "type": "boolean",
            "description": "为 true 且原文问答的首轮有效检索无命中时，在原任务等待原句。回答前需以 submit_lookup_receipt 补交资料。"
          },
          "awaitCalculationReceipt": {
            "type": "boolean",
            "default": false,
            "description": "仅适用于含 answer_calc 的服务版本。金额不足时保留本次运行，等待调用方补交原件；省略时沿用已有处理方式。"
          }
        },
        "not": { "required": ["attachment", "attachments"] },
        "required": [
          "version",
          "input",
          "authorizeCalls"
        ]
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "project": {
            "type": "string",
            "format": "uuid"
          },
          "statusUrl": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "project",
          "statusUrl"
        ]
      },
      "Progress": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "project": {
            "type": "string",
            "format": "uuid"
          },
          "service": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "controlRevision": {
            "type": "integer",
            "minimum": 1
          },
          "finalReviewer": {
            "type": "string"
          },
          "canConcludeFailure": {
            "type": "boolean",
            "description": "远端已明确失败或拒绝，且所有已发操作的结果已核对。允许控制此运行的调用方可填写原因并提交 confirm_failure。"
          },
          "nextAction": {
            "type": [
              "string",
              "null"
            ],
