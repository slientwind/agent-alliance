        </mxCell>
        <mxCell id="c41" parent="1" value="已确认默认值：个人 90 天复查、365 天有效；到期或离职后按 30 天回收规则处理。读取端判断有效性，清理任务稍后回收正文。" style="text;html=0;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#455e70;" vertex="1">
