  <diagram name="Agent Loop · 工作流、回合驱动与持久等待" id="alliance-loop">
    <mxGraphModel pageWidth="1600" pageHeight="1080" page="1" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" parent="1" value="Agent Loop · 工作流、回合驱动与持久等待" style="text;html=0;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=36;fontStyle=1;fontColor=#172f42;" vertex="1">
          <mxGeometry as="geometry" x="42" y="11.280000000000001" width="5" height="46.800000000000004" />
        </mxCell>
        <mxCell id="c2" parent="1" value="一个已确认的计划节点可以推进多个回合。Workflow 只依据活动返回的小型结果调度；允许访问模型、数据库和工具的代码运行在 Activity。" style="text;html=0;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=19;fontStyle=0;fontColor=#455e70;" vertex="1">
          <mxGeometry as="geometry" x="44" y="62.620000000000005" width="5" height="24.7" />
        </mxCell>
        <mxCell id="c3" parent="1" value="" style="rounded=1;arcSize=5;fillColor=#f0f4f6;strokeColor=#b7c8d0;dashed=0;pointerEvents=0;" vertex="1">
          <mxGeometry as="geometry" x="32" y="123" width="1528" height="194" />
        </mxCell>
        <mxCell id="c4" parent="1" value="Temporal Workflow  /  确定性调度" style="text;html=0;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#36596a;" vertex="1">
          <mxGeometry as="geometry" x="46" y="129.62" width="5" height="24.7" />
        </mxCell>
        <mxCell id="c5" parent="1" value="&lt;b style=&quot;font-size:20px;color:#174f45&quot;&gt;Collaborate / scheduleDAG&lt;/b&gt;&lt;div style=&quot;margin-top:3px&quot;&gt;加载有版本的计划拓扑，调度就绪节点&lt;/div&gt;&lt;div style=&quot;margin-top:3px&quot;&gt;固定执行路径继续使用 ExecuteStep&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=16;fillColor=#e8f5ef;strokeColor=#74a893;fontColor=#172f42;dashed=0;" vertex="1">
          <mxGeometry as="geometry" x="50" y="171" width="389" height="108" />
        </mxCell>
        <mxCell id="c6" parent="1" value="&lt;b style=&quot;font-size:20px;color:#784b16&quot;&gt;LoopController（拟新增）&lt;/b&gt;&lt;div style=&quot;margin-top:3px&quot;&gt;按分支调度 AdvanceTurn 或 ExecuteAction&lt;/div&gt;&lt;div style=&quot;margin-top:3px&quot;&gt;持久等待控制信号、业务待办与计时器&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=16;fillColor=#fff6e8;strokeColor=#c39a65;fontColor=#172f42;dashed=1;" vertex="1">
          <mxGeometry as="geometry" x="561" y="171" width="467" height="108" />
        </mxCell>
        <mxCell id="c7" parent="1" value="&lt;b style=&quot;font-size:20px;color:#784b16&quot;&gt;回合调度结果&lt;/b&gt;&lt;div style=&quot;margin-top:3px&quot;&gt;再推进 / 要派发 / 要等待 / 步骤结束&lt;/div&gt;&lt;div style=&quot;margin-top:3px&quot;&gt;只传标识、控制修订、状态和引用&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=16;fillColor=#fff6e8;strokeColor=#c39a65;fontColor=#172f42;dashed=1;" vertex="1">
