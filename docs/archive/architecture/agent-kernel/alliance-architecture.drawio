        <mxCell id="c37" parent="1" value="&lt;b style=&quot;font-size:20px;color:#174f45&quot;&gt;长期条目 / PostgreSQL&lt;/b&gt;&lt;div style=&quot;margin-top:3px&quot;&gt;preferences、team_rules、规则修订&lt;/div&gt;&lt;div style=&quot;margin-top:3px&quot;&gt;复查、过期、离职与清除状态&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=16;fillColor=#e8f5ef;strokeColor=#74a893;fontColor=#172f42;dashed=0;" vertex="1">
          <mxGeometry as="geometry" x="433" y="850" width="348" height="110" />
        </mxCell>
        <mxCell id="c38" parent="1" value="&lt;b style=&quot;font-size:20px;color:#784b16&quot;&gt;拟增反向依赖索引&lt;/b&gt;&lt;div style=&quot;margin-top:3px&quot;&gt;memory_revision → summary / turn&lt;/div&gt;&lt;div style=&quot;margin-top:3px&quot;&gt;按条目失效，清理作业可幂等重放&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=16;fillColor=#fff6e8;strokeColor=#c39a65;fontColor=#172f42;dashed=1;" vertex="1">
          <mxGeometry as="geometry" x="818" y="850" width="348" height="110" />
        </mxCell>
        <mxCell id="c39" parent="1" value="&lt;b style=&quot;font-size:20px;color:#174f45&quot;&gt;知识模块 / 只读引用&lt;/b&gt;&lt;div style=&quot;margin-top:3px&quot;&gt;source_id、版本、片段位置&lt;/div&gt;&lt;div style=&quot;margin-top:3px&quot;&gt;原件在对象卷；召回时重验范围&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontFamily=Arial;fontSize=16;fillColor=#e8f5ef;strokeColor=#74a893;fontColor=#172f42;dashed=0;" vertex="1">
          <mxGeometry as="geometry" x="1203" y="850" width="348" height="110" />
        </mxCell>
        <mxCell id="c40" parent="1" value="例：采购员更正金额显示偏好。新会话召回新修订；引用旧偏好的摘要先重算；已审核报价单沿用自身版本与访问期限。" style="text;html=0;align=left;verticalAlign=middle;spacing=0;whiteSpace=nowrap;overflow=visible;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#172f42;" vertex="1">
