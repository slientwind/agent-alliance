# Copy to a private .env file. Generate secrets locally; do not commit them.
# ALLIANCE_MASTER_KEY: openssl rand -base64 32
# ALLIANCE_DB_PASSWORD: openssl rand -hex 24 (URL-safe)
ALLIANCE_MASTER_KEY=
ALLIANCE_DB_PASSWORD=
ALLIANCE_PUBLIC_URL=https://agents.example.com
ALLIANCE_GRPC_PUBLIC_ADDR=https://agents-grpc.example.com
ALLIANCE_HTTP_PORT=8180
ALLIANCE_GRPC_PORT=8181
ALLIANCE_ALLOW_REGISTRATION=false
ALLIANCE_INSECURE_COOKIES=false
ALLIANCE_ALLOW_PRIVATE=false
ALLIANCE_RUN_TIMEOUT_SECONDS=300
